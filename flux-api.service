[Unit]
Description=FLUX.1-dev API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/user/Flux
Environment="FLUX_MODEL_PATH=/home/user/Flux/models/flux-dev"
Environment="FLUX_API_KEY=your-secret-api-key-here"
Environment="HF_TOKEN=your-huggingface-token"
ExecStart=/usr/bin/python3 api_server.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
